# Oasis infrastructure configuration
OASIS_PLATFORM=oasis

# Required secrets: generate with `openssl rand -hex 32`
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret
AUTHENTIK_ERROR_REPORTING_ENABLED=false

# Reverse proxy / Authentik
AUTH_DOMAIN=auth.oasis.innotel.us
ACME_EMAIL=admin@oasis.innotel.us
# Local mode publishes HTTP on 8080; production mode publishes HTTPS on 443.
HTTP_BIND=80
HTTPS_BIND=443
# Production certificates are stored in the certbot-etc Compose volume.
# See config/nginx/README.md and scripts/init-certificates.sh.

# Nginx Proxy Manager edge integration (scripts/npm-proxy-hosts.py).
# Provisioned hostnames: app.api.auth.mail.files.admin.<OASIS_BASE_DOMAIN>
# Base domain defaults to AUTH_DOMAIN with its first label stripped.
OASIS_BASE_DOMAIN=oasis.innotel.us
# Request a wildcard *.DOMAIN Let's Encrypt certificate via DNS-01.
# Requires NPM_DNS_PROVIDER + NPM_DNS_CREDENTIALS; otherwise an HTTP-01
# certificate covering the selected hostnames is requested instead.
OASIS_WILDCARD_SSL=true
NPM_API_URL=http://127.0.0.1:81
NPM_UPSTREAM_HOST=host.docker.internal
# NPM_API_TOKEN=                    # preferred over admin login
# NPM_ADMIN_EMAIL=
# NPM_ADMIN_PASSWORD=
# DNS-01 credentials for the NPM DNS provider (never commit these):
# NPM_DNS_PROVIDER=cloudflare
# NPM_DNS_CREDENTIALS=dns_cloudflare_api_token=token

# Zimbra builder settings
ZIMBRA_VERSION=latest
BASE_IMAGE=ubuntu:22.04
BUILD_UID=1000
BUILD_GID=1000
BUILD_DIR=./builds
SKIP_INSTALL=false
FORCE_REBUILD=false
TZ=Etc/UTC
DOCKER_DNS="8.8.8.8 1.1.1.1"
DOCKER_DNS1=8.8.8.8
DOCKER_DNS2=1.1.1.1

# ─── Infisical (SecretOps) ─────────────────────────────────────────
# Innotel Platform Stack: secrets live in Infisical; .env is derived from it.
# Generate the keys with:
#   openssl rand -base64 32   # INFISICAL_ENCRYPTION_KEY
#   openssl rand -hex 16      # INFISICAL_AUTH_SECRET
#   openssl rand -hex 16      # INFISICAL_DB_PASSWORD
# Then: docker compose -f docker-compose.yml -f compose.infisical.yml \
#         --profile infisical up -d
#       bash scripts/infisical-setup.sh
INFISICAL_PORT=8383
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ADMIN_EMAIL=
INFISICAL_ADMIN_PASSWORD=
INFISICAL_ORG=Innotel
