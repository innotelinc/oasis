# ┌──────────────────────────────────────────────────────────┐
# │  Zimbra FOSS Builder — environment template              │
# │  Copy to .env and edit:  cp .env.example .env            │
# │  build.sh loads .env automatically (build + deploy).     │
# └──────────────────────────────────────────────────────────┘

# ── Build Settings ─────────────────────────────────────────
ZIMBRA_VERSION=latest          # Zimbra version (e.g. 10.1.16 or latest)
BASE_IMAGE=ubuntu:22.04        # Target OS image (ubuntu:22.04, ubuntu:24.04, rockylinux:9, etc.)
BUILD_UID=1000                 # UID for build user in container
BUILD_GID=1000                 # GID for build user in container
BUILD_DIR=./builds             # Output directory for installer .tgz

# ── Build + Install flow ───────────────────────────────────
# `./build.sh` builds the installer and then installs it on this server
# (when run as root). Set SKIP_INSTALL=true to build only.
SKIP_INSTALL=false             # true = build only, skip the install step
FORCE_REBUILD=false            # true = rebuild even if the installer .tgz exists

# ── Optional ───────────────────────────────────────────────
# TZ=Etc/UTC                   # Timezone in container
# NO_CACHE=true                # Disable Docker build cache
# DOCKER_BUILD_OPTS=            # Extra docker build flags
# DOCKER_RUN_OPTS=              # Extra docker run flags

# ── DNS for the build container ────────────────────────────
# Space-separated resolver list passed to `docker run`. Defaults to public
# resolvers as a fallback for hosts whose /etc/resolv.conf points at the
# systemd-resolved stub (127.0.0.53), which the container can't reach — the
# usual cause of:
#     [ERROR] DNS resolution failed — cannot resolve github.com.
# Set to empty (DOCKER_DNS="") to use the Docker daemon's DNS, or to your own
# resolvers (e.g. corporate/VPN).
DOCKER_DNS="8.8.8.8 1.1.1.1"
#
# For a permanent (all containers) fix, add to /etc/docker/daemon.json:
#     { "dns": ["8.8.8.8", "1.1.1.1"] }
# then `sudo systemctl restart docker`. See README → Troubleshooting.
#
# docker-compose.yml reads a list, so it uses two separate vars with the
# same defaults (override them the same way for `docker compose up`):
# DOCKER_DNS1=8.8.8.8
# DOCKER_DNS2=1.1.1.1

# ── Deploy / SSH (./build.sh deploy user@host) ─────────────
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519   # Path to a specific private key
# DEPLOY_SSH_PORT=2222               # Non-standard SSH port
# DEPLOY_SSH_OPTS="-o ConnectTimeout=15"   # Extra ssh/scp options

# ── Install settings ───────────────────────────────────────
# The installer reads scripts/install-config.env by default (hostname, domain,
# admin passwords, SSL, outbound relay, skip flags, ...). Any of its variables
# can also be set here in .env — e.g.:
#   HOSTNAME=mail.example.com
#   DOMAIN=example.com
#   ZIMBRA_ADMIN_PASSWORD=changeme
#   RELAY_ENABLED=true
#   RELAY_HOST="[smtp.gmail.com]:587"
#   SKIP_SSL=false
#   SKIP_DEPS=false
#   DEPS_MARKER=/var/lib/zimbra-installer/.deps_done   # skip dep install once this file exists
#   SKIP_THEME=true
#   SKIP_RELAY=false
#   DRY_RUN=false              # true = install prints actions without running
