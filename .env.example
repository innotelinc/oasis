# Oasis infrastructure configuration
OASIS_PLATFORM=oasis

# Required secrets: generate with `openssl rand -hex 32`
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret
AUTHENTIK_ERROR_REPORTING_ENABLED=false

# Reverse proxy / Authentik
AUTH_DOMAIN=auth.oasis.innotel.us
ACME_EMAIL=admin@oasis.innotel.us
# Local mode publishes HTTP on 8080; production mode publishes HTTPS on 443.
HTTP_BIND=80
HTTPS_BIND=443
# Production certificates are stored in the certbot-etc Compose volume.
# See config/nginx/README.md and scripts/init-certificates.sh.

# Nginx Proxy Manager edge integration (scripts/npm-proxy-hosts.py).
# Provisioned hostnames: app.api.auth.mail.files.admin.<OASIS_BASE_DOMAIN>
# Base domain defaults to AUTH_DOMAIN with its first label stripped.
OASIS_BASE_DOMAIN=oasis.innotel.us
# Request a wildcard *.DOMAIN Let's Encrypt certificate via DNS-01.
# Requires NPM_DNS_PROVIDER + NPM_DNS_CREDENTIALS; otherwise an HTTP-01
# certificate covering the selected hostnames is requested instead.
OASIS_WILDCARD_SSL=true
NPM_API_URL=http://127.0.0.1:81
NPM_UPSTREAM_HOST=host.docker.internal
# NPM_API_TOKEN=                    # preferred over admin login
# NPM_ADMIN_EMAIL=
# NPM_ADMIN_PASSWORD=
# DNS-01 credentials for the NPM DNS provider (never commit these):
# NPM_DNS_PROVIDER=cloudflare
# NPM_DNS_CREDENTIALS=dns_cloudflare_api_token=token

# Zimbra builder settings
ZIMBRA_VERSION=latest
BASE_IMAGE=ubuntu:22.04
BUILD_UID=1000
BUILD_GID=1000
BUILD_DIR=./builds
SKIP_INSTALL=false
FORCE_REBUILD=false
TZ=Etc/UTC
DOCKER_DNS="8.8.8.8 1.1.1.1"
DOCKER_DNS1=8.8.8.8
DOCKER_DNS2=1.1.1.1

# ─── Cerulean Vault (SecretOps) ────────────────────────────────────
# The platform's only secret store: HashiCorp Vault (KV v2), hosted by
# Cerulean. Values live there, and .env may name one with a reference:
#
#   POSTGRES_PASSWORD=vault://cerulean/oasis#POSTGRES_PASSWORD
#
# Resolution is the operator's step, not this stack's: nothing here resolves a
# `vault://` value at runtime, so Compose would pass the literal string to the
# container. Write the resolved value into the gitignored .env (see
# docs/stack.md) and treat a reference left in place as a deployment error.
#
# Cerulean's Vault bootstrap mints this stack's path-scoped token
# (VAULT_PRODUCT_TOKENS=oasis there) and writes it to
# ./data/vault/token/oasis.token; copy that file in, then move any plaintext
# values across with scripts/vault-migrate.py:
#
#   VAULT_ADDR=http://<cerulean-host>:8200 \
#     VAULT_TOKEN_FILE=./data/vault/token/oasis.token \
#     VAULT_PREFIX=cerulean VAULT_PATH=oasis \
#     python3 scripts/vault-migrate.py --from-env-file .env \
#       --keys POSTGRES_PASSWORD,AUTHENTIK_CLIENT_SECRET
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/oasis.token
VAULT_PREFIX=cerulean
VAULT_PATH=oasis
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by Oasis mail.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us
