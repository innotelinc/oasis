# ┌──────────────────────────────────────────────────────────┐
# │  Zimbra FOSS Builder + Installer — Environment Config    │
# │  Copy to .env and customize                              │
# └──────────────────────────────────────────────────────────┘

# ── Build Settings ─────────────────────────────────────────
ZIMBRA_VERSION=latest          # Zimbra version (e.g. 10.1.16 or latest)
BASE_IMAGE=ubuntu:22.04        # Target OS image (ubuntu:22.04, rockylinux:9, etc.)
BUILD_UID=1000                 # UID for build user in container
BUILD_GID=1000                 # GID for build user in container
BUILD_DIR=./builds             # Output directory for installer .tgz

# ── Build + Install flow ───────────────────────────────────
# `./build.sh` builds the installer and then installs it on this server
# (when run as root). Set SKIP_INSTALL=true to build only.
SKIP_INSTALL=false             # true = build only, skip the install step
FORCE_REBUILD=false            # true = rebuild even if the installer .tgz exists

# ── Optional ───────────────────────────────────────────────
# TZ=Etc/UTC                   # Timezone in container
# NO_CACHE=true                # Disable Docker build cache
# DOCKER_BUILD_OPTS=            # Extra docker build flags
# DOCKER_RUN_OPTS=              # Extra docker run flags

# ── Install settings ───────────────────────────────────────
# The installer reads scripts/install-config.env by default (hostname, domain,
# admin passwords, SSL, outbound relay, skip flags, ...). Any of its variables
# can also be set here in .env — e.g.:
#   HOSTNAME=mail.example.com
#   DOMAIN=example.com
#   ZIMBRA_ADMIN_PASSWORD=changeme
#   RELAY_ENABLED=true
#   RELAY_HOST="[smtp.gmail.com]:587"
#   SKIP_SSL=false
#   SKIP_DEPS=false
#   DEPS_MARKER=/var/lib/zimbra-installer/.deps_done   # skip dep install once this file exists
#   SKIP_THEME=true
#   SKIP_RELAY=false
#   DRY_RUN=false              # true = install prints actions without running
