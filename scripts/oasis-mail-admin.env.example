# Oasis mail administration — scripts/oasis-mail-admin.py
#
# Install as /etc/oasis/oasis-mail-admin.env (mode 640, root:root) and reference
# it from systemd/oasis-mail-admin.service. SESSION_SECRET must be generated per
# host:  python3 -c 'import secrets; print(secrets.token_urlsafe(40))'

# Where the service listens. The edge (NPM) proxies the public name here.
LISTEN=0.0.0.0:8091

# Cerulean Authentik. The provider is the estate's Oasis admin client; it is
# already bound to the ADMIN_GROUP below, so membership is what gates the page.
ISSUER=https://auth.cerulean.innotel.us/application/o/oasis-admin/
CLIENT_ID=oasis-admin
# CLIENT_SECRET is normally left unset: the secret is read from Authentik at
# runtime rather than stored on disk. Set it only if Authentik is unreachable.
# CLIENT_SECRET=
REDIRECT_URI=https://admin.oasis.innotel.us/auth/callback

# The Authentik group a caller must be a member of. Checked against Authentik's
# own group records, never trusted from a token claim.
ADMIN_GROUP=Oasis

# Signs the session cookie. Required; without it sessions end at every restart.
SESSION_SECRET=generate-a-random-value-per-host

# Stalwart engine and its recovery admin (used for domains and mailboxes).
STALWART_BASE=https://mail.innotel.us
STALWART_ENV=/etc/stalwart/stalwart.env
# Authentik admin token is read from Cerulean Vault through this token file.
VAULT_TOKEN_FILE=/etc/oasis/vault-token
MX_HOST=mail.innotel.us
