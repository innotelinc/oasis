# Oasis mail administration — scripts/oasis-mail-admin.py
#
# Install as /etc/oasis/oasis-mail-admin.env (mode 640, root:root) and reference
# it from systemd/oasis-mail-admin.service. SESSION_SECRET must be generated per
# host:  python3 -c 'import secrets; print(secrets.token_urlsafe(40))'

# Where the service listens. The edge (NPM) proxies the public name here.
LISTEN=0.0.0.0:8091

# Cerulean Authentik. The provider is the estate's Oasis admin client; it is
# already bound to the ADMIN_GROUP below, so membership is what gates the page.
ISSUER=https://auth.cerulean.innotel.us/application/o/oasis-admin/
CLIENT_ID=oasis-admin
# CLIENT_SECRET is normally left unset: the secret is read from Authentik at
# runtime rather than stored on disk. Set it only if Authentik is unreachable.
# CLIENT_SECRET=
REDIRECT_URI=https://admin.oasis.innotel.us/auth/callback

# The Authentik group a caller must be a member of. Checked against Authentik's
# own group records, never trusted from a token claim.
ADMIN_GROUP=Oasis

# Signs the session cookie. Required; without it sessions end at every restart.
SESSION_SECRET=generate-a-random-value-per-host

# Stalwart engine and its recovery admin (used for domains and mailboxes).
STALWART_BASE=https://mail.innotel.us
STALWART_ENV=/etc/stalwart/stalwart.env
# Authentik admin token is read from Cerulean Vault through this token file.
VAULT_TOKEN_FILE=/etc/oasis/vault-token
MX_HOST=mail.innotel.us

# Outbound mail leaves through a relay (this host's ISP blocks port 25), so a
# tenant's own SPF has to name that relay: Stalwart renders `v=spf1 mx -all`,
# which authorises this host and not the smarthost the mail is actually handed
# to. The include is added to the SPF this service publishes; an SPF already in
# the zone is the operator's and is never rewritten. Empty turns the rewrite off.
SPF_RELAY_INCLUDE=spf.mailjet.com

# The estate's public nameservers. Used only for a brand-new apex domain, where
# the registrar has to be pointed at them (a name inside a domain the estate
# already serves is delegated automatically).
PUBLIC_NS=ns1.innotel.us,ns2.innotel.us

# Zones the page must never remove, whatever else it is asked to do. Cerulean
# refuses its own platform zones regardless; this is the second guard.
PROTECTED_ZONES=innotel.us

# The machine surface (/api/service/*), for tenant provisioning. An application
# calls Cerulean, never this host; Cerulean then calls here with the caller's own
# key, which is verified *with Cerulean on every request* — this host keeps no
# token list, so revoking a key in Cerulean revokes it here too. No browser
# session is accepted on these routes: an operator's cookie is a different
# principal from a machine caller.
# Only these source addresses may reach /api/service/* at all, so the machine
# surface is not on the internet even for a caller holding a valid key.
MAIL_SERVICE_CLIENTS=192.168.1.71,127.0.0.1,::1
# The bridge to ask about a key, and the scopes Cerulean must say it carries.
CERULEAN_API_URL=http://192.168.1.71:3003/api
PROVISION_SCOPE=mail:provision
READ_SCOPE=mail:read
