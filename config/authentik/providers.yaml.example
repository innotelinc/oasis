# Oasis OIDC provider catalog (template)
#
# This file documents the clients to create in Authentik. It is intentionally
# not consumed automatically: client secrets must be generated by Authentik
# and stored outside source control.

issuer: https://auth.oasis.innotel.us/application/o/oasis/
scopes:
  - openid
  - profile
  - email
  - groups
  - oasis_tenant

clients:
  - name: oasis-app
    slug: oasis-app
    client_type: public
    grant_types: [authorization_code]
    require_pkce: true
    redirect_uris:
      - https://app.oasis.innotel.us/auth/callback
      - http://localhost:3000/auth/callback

  - name: oasis-api
    slug: oasis-api
    client_type: confidential
    grant_types: [authorization_code, client_credentials]
    redirect_uris: []
    audience: oasis-api

  - name: oasis-admin
    slug: oasis-admin
    client_type: confidential
    grant_types: [authorization_code]
    redirect_uris:
      - https://admin.oasis.innotel.us/auth/callback
      - http://localhost:3001/auth/callback

  - name: oasis-files
    slug: oasis-files
    client_type: confidential
    grant_types: [authorization_code]
    redirect_uris:
      - https://files.oasis.innotel.us/oauth/callback

  - name: oasis-mail
    slug: oasis-mail
    client_type: confidential
    grant_types: [authorization_code]
    redirect_uris:
      - https://mail.oasis.innotel.us/oauth/callback

claims:
  oasis_tenant:
    source: user.attribute.tenant_id
    type: string
  groups:
    source: group.name
    type: list
